Description: Set the Alpine musl SONAME on libc.so
 Alpine builds musl with -Wl,-soname,libc.musl-armv7.so.1 so that
 dynamically linked binaries carry DT_NEEDED libc.musl-armv7.so.1, which
 is the name the on-device loader stages as a symlink to
 /lib/ld-musl-armhf.so.1. Upstream musl leaves libc.so without a SONAME,
 so binaries link libc.so, which the device loader cannot resolve. The
 LibreEcho image builder asserts this exact DT_NEEDED on busybox, so the
 hosted toolchain must reproduce it.
Forwarded: not-needed
Author: LibreEcho CI
--- a/Makefile
+++ b/Makefile
@@ -160,7 +160,7 @@
 
 lib/libc.so: $(LOBJS) $(LDSO_OBJS)
 	$(CC) $(CFLAGS_ALL) $(LDFLAGS_ALL) -nostdlib -shared \
-	-Wl,-e,_dlstart -o $@ $(LOBJS) $(LDSO_OBJS) $(LIBCC)
+	-Wl,-e,_dlstart -Wl,-soname,libc.musl-armv7.so.1 -o $@ $(LOBJS) $(LDSO_OBJS) $(LIBCC)
 
 lib/libc.a: $(AOBJS)
 	rm -f $@
